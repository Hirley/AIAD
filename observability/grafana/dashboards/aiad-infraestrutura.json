{
  "uid": "aiad-infra",
  "title": "AIAD — Infraestrutura e API",
  "tags": ["aiad"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Throughput por rota",
      "description": "Requisições por segundo. A rota é o rótulo normalizado: caminho inventado cai em \"outra\".",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(aiad_http_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latência p95 por rota",
      "description": "Percentil, não média: dez respostas de 1 s e uma de 30 s dão uma média tranquila e um usuário irritado.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(aiad_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{route}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(aiad_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Memória residente",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 268435456 },
              { "color": "red", "value": 536870912 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "aiad_process_resident_memory_bytes" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "CPU",
      "description": "Fração de um núcleo consumida pelo processo.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 2 },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "rate(aiad_process_cpu_seconds_total[5m])" }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Em andamento",
      "description": "Requisições sendo atendidas agora. O Puma atende com cinco threads: encostar em cinco é fila.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 4 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "aiad_http_requests_in_flight" }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Taxa de erro (5xx)",
      "description": "Sem requisição nenhuma a divisão não existe, e o painel fica vazio em vez de mostrar zero — que é o correto: não houve erro porque não houve tráfego.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(aiad_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(aiad_http_requests_total[5m]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Recusas de credencial (401 e 403)",
      "description": "Pico de 401 é chave rotacionada sem avisar ou alguém adivinhando credencial. Pico de 403 é chave válida batendo em rota que não é dela. Só aparecem aqui porque a métrica fica por fora da autenticação.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status, route) (rate(aiad_http_requests_total{status=~\"40[13]\"}[5m]))",
          "legendFormat": "{{status}} {{route}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Log da API",
      "description": "Uma linha JSON por requisição. Nunca traz o corpo nem a credencial: da chave vai só o nome do principal.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\".*api.*\"}",
          "queryType": "range"
        }
      ]
    }
  ]
}
