# Chaves de API: nome:chave:escopos, separadas por ponto e vírgula.
# Escopos: read (buscar e perguntar) e write (ingerir documentos).
# Gere chaves com: ruby -rsecurerandom -e 'puts SecureRandom.hex(32)'
AIAD_API_KEYS=leitor:troque-esta-chave:read;ingestor:troque-esta-tambem:read,write

# Qdrant
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# Coleção e recuperação
AIAD_COLLECTION=documentos
AIAD_TOP_K=4
