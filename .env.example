# Chaves de API: nome:chave:escopos, separadas por ponto e vírgula.
# Escopos: read (buscar e perguntar), write (ingerir documentos) e metrics
# (raspar /metrics). O terceiro é separado de propósito: o Prometheus não
# precisa ler documento, e quem lê documento não precisa ver a operação.
# Gere chaves com: ruby -rsecurerandom -e 'puts SecureRandom.hex(32)'
AIAD_API_KEYS=leitor:troque-esta-chave:read;ingestor:troque-esta-tambem:read,write;prometheus:troque-esta-terceira:metrics

# Qdrant
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# Coleção e recuperação
AIAD_COLLECTION=documentos
AIAD_TOP_K=4

# Stack de observabilidade (profile "observabilidade").
# O token é a mesma chave de escopo `metrics` declarada acima, sozinha: o
# Prometheus manda só o token no header, não a linha inteira de configuração.
AIAD_METRICS_TOKEN=troque-esta-terceira
GRAFANA_PASSWORD=troque-esta-senha

# Modelo de verdade (opcional). Sem a chave, a API responde de forma extrativa
# e a rota /agent devolve 503 dizendo o que configurar.
# ANTHROPIC_API_KEY=
# AIAD_MODEL=claude-sonnet-5
