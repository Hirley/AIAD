# Chaves de API: nome:chave:escopos, separadas por ponto e vírgula.
# Escopos: read (buscar e perguntar), write (ingerir documentos) e metrics
# (raspar /metrics). O terceiro é separado de propósito: o Prometheus não
# precisa ler documento, e quem lê documento não precisa ver a operação.
# Gere chaves com: ruby -rsecurerandom -e 'puts SecureRandom.hex(32)'
AIAD_API_KEYS=leitor:troque-esta-chave:read;ingestor:troque-esta-tambem:read,write;prometheus:troque-esta-terceira:metrics

# Qdrant
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# Coleção e recuperação
AIAD_COLLECTION=documentos
AIAD_TOP_K=4

# Piso de relevancia: fracao dos termos de conteudo da pergunta que precisam
# aparecer no trecho para ele ser usado. Abaixo disso a API responde "nao
# encontrei" em vez de citar o documento menos ruim com conviccao. 0 desliga.
#
# O padrao 0,45 foi calibrado em 11 perguntas contra 3 documentos, o que e
# pouco: ajuste olhando a taxa de recusa. Subindo sem motivo, o piso esta
# alto; pergunta sem resposta sendo respondida, esta baixo.
AIAD_RELEVANCE_FLOOR=0.45

# Tetos do aquecimento do indice lexico, que roda ANTES de o Puma abrir a
# porta. Sem eles um acervo grande faria a API nao subir, em vez de subir com
# metade da busca -- e nao subir e pior. Estourando qualquer um dos dois, a API
# sobe com o indice parcial e `aiad_lexical_index_complete` marca 0.
AIAD_LEXICAL_INDEX_MAX=50000
AIAD_LEXICAL_INDEX_TIMEOUT=30

# Stack de observabilidade (profile "observabilidade").
# O token é a mesma chave de escopo `metrics` declarada acima, sozinha: o
# Prometheus manda só o token no header, não a linha inteira de configuração.
AIAD_METRICS_TOKEN=troque-esta-terceira
GRAFANA_PASSWORD=troque-esta-senha

# Modelo de verdade (opcional). Sem a chave, a API responde de forma extrativa
# e a rota /agent devolve 503 dizendo o que configurar.
# ANTHROPIC_API_KEY=
# AIAD_MODEL=claude-sonnet-5

# Rastreamento das perguntas no Langfuse (opcional). Precisa das duas chaves:
# com só uma, o exportador nao e montado e o trace vai so para o Prometheus.
# Os dois destinos respondem perguntas diferentes -- o Prometheus diz que o
# custo subiu ontem as 3h, o Langfuse diz por que.
#
# ATENCAO: o formato do payload mandado ao Langfuse nunca foi verificado
# contra uma instancia real. Veja o comentario no topo de lib/langfuse_batch.rb
# antes de apontar isto para uma conta de verdade.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_URL=https://cloud.langfuse.com

# Memoria da conversa do /agent.
# AIAD_HISTORY_BUDGET: tokens de historico que vao no prompt a cada pergunta.
# AIAD_MAX_SESSIONS: conversas guardadas em memoria; passado o teto, a menos
# recentemente usada sai.
AIAD_HISTORY_BUDGET=400
AIAD_MAX_SESSIONS=500
